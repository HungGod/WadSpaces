{
  "name": "wadbrowser",
  "productName": "WadBrowser",
  "version": "0.1.0",
  "description": "Chromium-based minimal browser with packager integration",
  "main": "main.js",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron .",
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "build": "ELECTRON_RUN_AS_NODE= electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.wadbrowser.app",
    "productName": "WadBrowser",
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*",
      "renderer/**/*",
      "dist/**/*",
      "packager/**/*",
      "README.md",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "WadBrowser.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
