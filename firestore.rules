rules_version = '2';
// users/{uid}/workspaces  saved workspace designs (owner only)
// users/{uid}/machines    enrolled machines + their command queue (hosted mode, later)
// enrollCodes/{code}      one-time codes, redeemed only by the enrollMachine function
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid && request.auth.token.get("role", "user") != "machine"; }
    function isMachine(uid, mid) {
      return signedIn() && request.auth.token.get("role", "") == "machine"
        && request.auth.token.owner == uid && request.auth.token.machineId == mid;
    }
    function isOwnersMachine(uid) {
      return signedIn() && request.auth.token.get("role", "") == "machine" && request.auth.token.owner == uid;
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /workspaces/{wsId} {
        allow read, write: if isOwner(uid);
        allow read: if isOwnersMachine(uid);
      }

      match /machines/{mid} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanges(["name"]);
        allow read: if isMachine(uid, mid);
        allow update: if isMachine(uid, mid)
          && onlyChanges(["lastSeen", "hostname", "daemonVersion", "view", "workspaces"]);

        match /commands/{cmdId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.status == "pending"
            && request.resource.data.type in ["switch", "start", "stop", "restart", "launcher", "navigate", "refresh", "sync-secrets"];
          allow read: if isMachine(uid, mid);
          allow update: if isMachine(uid, mid) && onlyChanges(["status", "result", "startedAt", "finishedAt"]);
        }
      }
    }

    match /enrollCodes/{code} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.used == false;
    }
  }
}
