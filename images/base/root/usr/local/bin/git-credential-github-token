#!/usr/bin/env bash
# git credential helper for WadSpaces workspaces.
#
# git invokes this as `<helper> get` and reads key=value lines from stdout.
# The token is looked up at request time and never persisted: it lives only in
# podman's secret store, exposed read-only at $GITHUB_TOKEN_FILE.
#
# Order is file-then-env on purpose. The desktop session inherits the container
# environment (svc-de runs with-contenv), so $GITHUB_TOKEN would usually work
# too, but the secret file is the path that holds up regardless of how the
# caller was spawned.

[[ "$1" == "get" ]] || exit 0

TOKEN_FILE="${GITHUB_TOKEN_FILE:-/run/secrets/github_token}"

if [[ -r "${TOKEN_FILE}" ]]; then
  TOKEN="$(tr -d '\r\n' < "${TOKEN_FILE}")"
else
  TOKEN="${GITHUB_TOKEN:-}"
fi

# No token: exit clean and say nothing, so git falls through to its normal
# "authentication failed" path instead of prompting on a headless stdin.
[[ -n "${TOKEN}" ]] || exit 0

echo "username=x-access-token"
echo "password=${TOKEN}"
