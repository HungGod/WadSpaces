#!/usr/bin/env bash
# Build-time: create a Chrome "app window" launcher for a website.
#
#   wadspaces-webapp "Claude" https://claude.ai
#   wadspaces-webapp --id claude "Claude" https://claude.ai
#
# Writes /usr/share/applications/wadspaces-webapp-<id>.desktop running
# `google-chrome --app=<url>` in its own window class, fetches an icon, and
# lists the launcher for the Desktop. The id defaults to a slug of the name;
# Wad Creator passes its catalog id, and wadspaces-layout finds the launcher
# through /etc/wadspaces/apps.d/<id>.list. A real PWA install is not needed:
# the --app window is what a PWA gives you, minus the manifest. All web apps
# share the default Chrome profile, so one Google sign-in covers Gmail, Drive, etc.
set -euo pipefail
export CURL_HOME=/usr/local/lib/wadspaces  # .curlrc: retries
APP_ID=""
if [[ "${1:-}" == "--id" ]]; then
    APP_ID="$2"; shift 2
    [[ "${APP_ID}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "bad app id: ${APP_ID}" >&2; exit 2; }
fi
[[ $# -eq 2 ]] || { echo "usage: wadspaces-webapp [--id <id>] <name> <url>" >&2; exit 2; }
NAME="$1"; URL="$2"

command -v google-chrome > /dev/null || { echo "wadspaces-webapp needs the chrome feature first" >&2; exit 1; }

SLUG="${APP_ID:-$(printf '%s' "${NAME}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')}"
ID="wadspaces-webapp-${SLUG}"
HOST="$(printf '%s' "${URL}" | sed -E 's#^[a-z]+://##; s#/.*$##')"
ICON_DIR=/usr/share/icons/hicolor/256x256/apps
mkdir -p "${ICON_DIR}"

# Google's favicon service, for the host and then its parent domain (it does
# not know e.g. console.cloud.google.com). A few rounds, because build-time
# DNS can drop out for longer than curl's own retries.
fetch_icon() {
    local h="$1"
    curl -fsSL -o "${ICON_DIR}/${ID}.png" "https://www.google.com/s2/favicons?domain=${h}&sz=256"
}
GOT=""
for attempt in 1 2 3; do
    if fetch_icon "${HOST}" || { [[ "${HOST}" == *.*.* ]] && fetch_icon "${HOST#*.}"; }; then
        GOT=1; break
    fi
    sleep 5
done
if [[ -z "${GOT}" ]]; then
    echo "webapp: no icon for ${HOST}, using the fallback"
    cp /usr/share/wadspaces/webapp-fallback.png "${ICON_DIR}/${ID}.png"
fi

cat > "/usr/share/applications/${ID}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=${NAME}
Comment=${URL}
Exec=/usr/local/bin/google-chrome --app=${URL} --class=${ID}
Icon=${ID}
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=${ID}
EOF

mkdir -p /etc/wadspaces/desktop-entries.d /etc/wadspaces/apps.d
echo "${ID}.desktop" >> /etc/wadspaces/desktop-entries.d/webapps.list
[[ -n "${APP_ID}" ]] && echo "${ID}.desktop" > "/etc/wadspaces/apps.d/${APP_ID}.list"
echo "webapp: ${NAME} -> ${URL}"
