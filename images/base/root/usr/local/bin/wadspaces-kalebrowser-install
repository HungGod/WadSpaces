#!/usr/bin/env bash
# Build-time: install KaleBrowser to /opt/kalebrowser and package the sites in
# a resources.json as desktop apps (launchers, icons, .desktop entries).
#
#   wadspaces-kalebrowser-install --resources /etc/wadspaces/kalebrowser-resources.json [--ref main]
#
# Source: https://github.com/HungGod/KaleBrowser at --ref, unless a local
# snapshot was baked into the build context at
# /opt/wadspaces-src/kalebrowser.tar (a local KaleBrowser snapshot put in the build folder),
# which is used instead and then deleted.
set -euo pipefail
export CURL_HOME=/usr/local/lib/wadspaces  # .curlrc: retries

REPO="https://github.com/HungGod/KaleBrowser.git"
REF="main"
RESOURCES=""
PREFIX="/opt/kalebrowser"
LOCAL_TAR="/opt/wadspaces-src/kalebrowser.tar"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ref) REF="$2"; shift 2 ;;
        --resources) RESOURCES="$2"; shift 2 ;;
        --prefix) PREFIX="$2"; shift 2 ;;
        --repo) REPO="$2"; shift 2 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[[ -f "${RESOURCES}" ]] || { echo "--resources <file> is required" >&2; exit 2; }
command -v npm > /dev/null || { echo "run 'wadspaces-feature kalebrowser' first" >&2; exit 1; }

log() { echo "**** [kalebrowser] $* ****"; }

rm -rf "${PREFIX}"
if [[ -f "${LOCAL_TAR}" ]]; then
    log "using local snapshot ${LOCAL_TAR}"
    mkdir -p "${PREFIX}"
    tar -xf "${LOCAL_TAR}" -C "${PREFIX}"
    rm -rf /opt/wadspaces-src
else
    log "cloning ${REPO} @ ${REF}"
    git clone --depth 1 --branch "${REF}" "${REPO}" "${PREFIX}"
    rm -rf "${PREFIX}/.git"
fi

cd "${PREFIX}"
if ! grep -q -- '--system' packager/packager.py; then
    echo "KaleBrowser @ ${REF} has no packager --system mode; push it or use --kalebrowser-local" >&2
    exit 1
fi

log "npm ci"
# electron is a devDependency. Since Electron 43 the binary is no longer
# fetched by a postinstall; it downloads on first launch, which would fail at
# runtime in a root-owned /opt. Fetch it now and launch the binary directly.
npm ci --no-audit --no-fund
node node_modules/electron/install.js
ELECTRON_BIN="${PREFIX}/node_modules/electron/dist/$(cat node_modules/electron/path.txt)"
[[ -x "${ELECTRON_BIN}" ]] || { echo "electron binary missing at ${ELECTRON_BIN}" >&2; exit 1; }
rm -rf node_modules/electron-builder node_modules/app-builder-bin

log "packaging $(jq length "${RESOURCES}") sites"
/usr/bin/python3 -m venv /tmp/kale-venv
/tmp/kale-venv/bin/pip install --quiet --no-cache-dir -r packager/requirements.txt
cp "${RESOURCES}" packager/resources.json
(
    cd packager
    /tmp/kale-venv/bin/python packager.py --system \
        --input resources.json \
        --output "${PREFIX}/packager/generated" \
        --project-dir "${PREFIX}" \
        --electron-bin "${ELECTRON_BIN}" \
        --electron-args=--no-sandbox \
        --wayland-auto \
        --entries-list /etc/wadspaces/desktop-entries.d/kalebrowser.list
)
rm -rf /tmp/kale-venv /root/.npm /root/.cache
log "installed: $(tr '\n' ' ' < /etc/wadspaces/desktop-entries.d/kalebrowser.list)"
