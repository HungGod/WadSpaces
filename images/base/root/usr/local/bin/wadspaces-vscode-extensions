#!/usr/bin/python3
"""VS Code extensions in a wadspace's image, and in each wadspace's home.

    wadspaces-vscode-extensions <id>...      build time (a customization's RUN)
    wadspaces-vscode-extensions --seed <home>  every start (init-wadspaces-workspace), as abc

At build time each marketplace id is installed with VS Code's own CLI into
/usr/share/wadspaces/vscode-extensions (needs the vscode feature) and listed in
/etc/wadspaces/vscode-extensions.list.

At start, any listed extension that <home>/.vscode/extensions doesn't have yet
is copied there and added to that folder's extensions.json (VS Code only loads
what that index lists). One already there is left alone, whatever its version:
the user may have updated it, and the image's copy stays as it was built.
"""
import json
import os
import re
import shutil
import subprocess
import sys

DIR = "/usr/share/wadspaces/vscode-extensions"
LIST = "/etc/wadspaces/vscode-extensions.list"
ID = re.compile(r"^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+$")


def log(msg):
    print(f"[wadspaces-vscode-extensions] {msg}", flush=True)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def listed():
    try:
        with open(LIST) as f:
            return [line.strip() for line in f if line.strip() and not line.startswith("#")]
    except OSError:
        return []


def install(ids):
    bad = [i for i in ids if not ID.match(i)]
    if bad:
        sys.exit(f"not a marketplace id: {', '.join(bad)}")
    if not shutil.which("code"):
        sys.exit("wadspaces-vscode-extensions needs VS Code (the vscode feature) first")
    os.makedirs(DIR, exist_ok=True)
    data = "/tmp/wadspaces-vscode-build"
    for ext in ids:
        log(f"installing {ext}")
        subprocess.run(
            ["code", "--no-sandbox", "--user-data-dir", data, "--extensions-dir", DIR, "--install-extension", ext, "--force"],
            check=True,
        )
    shutil.rmtree(data, ignore_errors=True)
    shutil.rmtree("/root/.vscode", ignore_errors=True)
    have = listed()
    os.makedirs(os.path.dirname(LIST), exist_ok=True)
    with open(LIST, "w") as f:
        for ext in have + [i for i in ids if i.lower() not in (h.lower() for h in have)]:
            f.write(ext + "\n")
    # Anyone may read them; each home gets its own copy.
    subprocess.run(["chmod", "-R", "a+rX", DIR], check=True)


def ext_id(entry):
    return str(entry.get("identifier", {}).get("id", "")).lower()


def moved(location, old, new):
    """An extensions.json location, with the extension's folder moved."""
    out = dict(location)
    for k in ("fsPath", "path"):
        if isinstance(out.get(k), str) and out[k].startswith(old):
            out[k] = new + out[k][len(old):]
    if isinstance(out.get("external"), str):
        out["external"] = out["external"].replace("file://" + old, "file://" + new, 1)
    return out


def seed(home):
    want = listed()
    if not want:
        return
    image = load(os.path.join(DIR, "extensions.json"), [])
    dest = os.path.join(home, ".vscode", "extensions")
    os.makedirs(dest, exist_ok=True)
    index_path = os.path.join(dest, "extensions.json")
    index = load(index_path, [])
    have = {ext_id(e) for e in index}
    added = []
    for ext in want:
        if ext.lower() in have:
            continue
        entry = next((e for e in image if ext_id(e) == ext.lower()), None)
        folder = entry and entry.get("relativeLocation")
        if not folder or not os.path.isdir(os.path.join(DIR, folder)):
            log(f"WARN: {ext} isn't in the image's extensions")
            continue
        target = os.path.join(dest, folder)
        if not os.path.exists(target):
            shutil.copytree(os.path.join(DIR, folder), target, symlinks=True)
        copy = dict(entry)
        copy["location"] = moved(entry.get("location", {}), os.path.join(DIR, folder), target)
        index.append(copy)
        added.append(ext)
    if added:
        tmp = index_path + ".wadspaces"
        with open(tmp, "w") as f:
            json.dump(index, f)
        os.replace(tmp, index_path)
        log(f"added {', '.join(added)}")


def main():
    args = sys.argv[1:]
    if args[:1] == ["--seed"] and len(args) == 2:
        seed(args[1])
    elif args and not args[0].startswith("-"):
        install(args)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
