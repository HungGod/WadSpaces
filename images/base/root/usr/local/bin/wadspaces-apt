#!/usr/bin/env bash
# Build-time: install a desktop app from Debian and note its launcher.
#
#   wadspaces-apt gimp --desktop gimp.desktop gimp
#   wadspaces-apt freecad freecad            (launcher found automatically)
#   wadspaces-apt --clean                     (last, in the same RUN)
#
# Writes the launcher's basename to /etc/wadspaces/apps.d/<app-id>.list, where
# wadspaces-layout looks it up when it puts the app on the desktop. Without
# --desktop it takes the first new visible launcher the packages added.
# WadSpaces Client generates one RUN with every app, ending in --clean, so apt's
# lists are fetched once and don't stay in the image.
set -euo pipefail
export CURL_HOME=/usr/local/lib/wadspaces  # .curlrc: retries
export DEBIAN_FRONTEND=noninteractive
APPS=/usr/share/applications

log() { echo "**** [wadspaces-apt] $* ****"; }

if [[ "${1:-}" == "--clean" ]]; then
    apt-get autoclean
    rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*
    exit 0
fi

usage() { echo "usage: wadspaces-apt <app-id> [--desktop <file.desktop>] <package>... | --clean" >&2; exit 2; }
[[ $# -ge 2 ]] || usage
APP="$1"; shift
[[ "${APP}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "bad app id: ${APP}" >&2; exit 2; }
DESKTOP=""
if [[ "${1:-}" == "--desktop" ]]; then
    DESKTOP="$2"; shift 2
fi
[[ $# -ge 1 ]] || usage
for p in "$@"; do
    [[ "${p}" =~ ^[a-z0-9][a-z0-9+.-]+$ ]] || { echo "bad package name: ${p}" >&2; exit 2; }
done

visible() {
    # Launchers a desktop would show: not NoDisplay/Hidden, and an application.
    local f
    for f in "${APPS}"/*.desktop; do
        [[ -f "$f" ]] || continue
        grep -qiE '^(NoDisplay|Hidden)=true' "$f" && continue
        grep -q '^Type=Application' "$f" || continue
        basename "$f"
    done | sort
}

BEFORE="$(visible)"
# Fetch the lists once per RUN (the previous app in this RUN already did).
if [[ -z "$(ls -A /var/lib/apt/lists 2> /dev/null | grep -v -e '^lock$' -e '^partial$' || true)" ]]; then
    log "updating package lists"
    apt-get update
fi
log "installing ${APP}: $*"
apt-get install -y --no-install-recommends "$@"

# Chromium from Debian needs these to run as the desktop user in a container.
if [[ -d /etc/chromium.d ]] && [[ ! -f /etc/chromium.d/wadspaces ]]; then
    echo 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --ozone-platform-hint=auto --password-store=basic"' > /etc/chromium.d/wadspaces
fi

if [[ -n "${DESKTOP}" ]] && [[ ! -f "${APPS}/${DESKTOP}" ]]; then
    log "WARN: ${DESKTOP} isn't in ${APPS}; looking for the launcher ${APP} added instead"
    DESKTOP=""
fi
if [[ -z "${DESKTOP}" ]]; then
    DESKTOP="$(comm -13 <(printf '%s\n' "${BEFORE}") <(visible) | head -n1)"
fi
mkdir -p /etc/wadspaces/apps.d
if [[ -n "${DESKTOP}" ]]; then
    echo "${DESKTOP}" > "/etc/wadspaces/apps.d/${APP}.list"
    log "${APP} -> ${DESKTOP}"
else
    log "WARN: ${APP} added no launcher; it won't get a desktop icon"
fi
