#!/usr/bin/env bash
# Write a launcher for a Chromium/Electron binary that works inside the
# workspace session, the same way the Writing image's obsidian wrapper does:
#   --no-sandbox                  the desktop user cannot use the setuid sandbox here
#   --ozone-platform=wayland      only when there is a GPU node and labwc is running
#
#   wadspaces-wrap-electron <real-binary> <wrapper-path> [extra args...]
set -euo pipefail
[[ $# -ge 2 ]] || { echo "usage: wadspaces-wrap-electron <binary> <wrapper> [args...]" >&2; exit 2; }

BIN="$1"; OUT="$2"; shift 2
EXTRA=""
for a in "$@"; do EXTRA+=" $(printf '%q' "$a")"; done

mkdir -p "$(dirname "${OUT}")"
cat > "${OUT}" <<EOF
#!/bin/bash
# generated by wadspaces-wrap-electron
BIN=$(printf '%q' "${BIN}")

WAYLAND=""
if ls /dev/dri/* > /dev/null 2>&1 && pgrep labwc > /dev/null 2>&1; then
  WAYLAND="--ozone-platform=wayland"
fi

exec "\${BIN}" --no-sandbox \${WAYLAND}${EXTRA} "\$@"
EOF
chmod 755 "${OUT}"
