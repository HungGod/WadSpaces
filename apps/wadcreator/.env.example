# Copy to .env.local (never committed). The web app's config from the Firebase
# console: Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wad-spaces.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wad-spaces
VITE_FIREBASE_MESSAGING_SENDER_ID=500223679834
VITE_FIREBASE_APP_ID=

# 1 = use the local emulators (firebase emulators:start) instead of the project.
VITE_USE_EMULATORS=0
# Where the emulators run, when not on this machine (default 127.0.0.1).
VITE_EMULATOR_HOST=

# Offline app only: wadd on this machine (default http://127.0.0.1:8080).
VITE_WADD_URL=
