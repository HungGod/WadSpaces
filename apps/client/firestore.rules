rules_version = '2';
// Who can read and write what. People sign in with Firebase Auth; machines
// sign in with a custom token from the enrollMachine function, carrying
// {role: "machine", owner: <uid>, machineId}. Cloud Functions (admin SDK)
// bypass these rules; fields marked "functions only" are theirs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMachineToken() { return signedIn() && request.auth.token.get("role", "user") == "machine"; }
    function isUser() { return signedIn() && !isMachineToken(); }
    function isOwner(uid) { return isUser() && request.auth.uid == uid; }
    function isMachine(uid, mid) { return isMachineToken() && request.auth.token.owner == uid && request.auth.token.machineId == mid; }
    function isOwnersMachine(uid) { return isMachineToken() && request.auth.token.owner == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function keeps(keys) { return !changed().hasAny(keys); }

    // ---------------------------------------------------------------- people
    // A username is claimed once, in the same transaction that creates the
    // profile (see src/data/cloud/auth.ts claimUsername).
    match /usernames/{name} {
      // Sign-up checks availability before the account exists. No listing.
      allow get: if true;
      allow create: if isUser()
        && name.matches('^[a-z0-9_.-]{3,24}$')
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == name;
    }

    match /profiles/{uid} {
      function profileKeys() {
        // startersCreated: the starter templates (Writing, Dev) were made in
        // this library once, so a deleted one doesn't come back.
        return request.resource.data.keys().hasOnly(["username", "displayName", "color", "photoURL", "onboarded", "lastSession", "createdAt", "startersCreated"])
          && (!("startersCreated" in request.resource.data) || request.resource.data.startersCreated is bool);
      }
      // Other people see your name and avatar (owners of shared wadspaces).
      allow read: if signedIn();
      allow create: if isOwner(uid) && profileKeys()
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isOwner(uid) && profileKeys() && keeps(["username", "createdAt"]);
    }

    // ------------------------------------------------------------ wadspaces
    // owner and sharedWith are uids.
    match /wadspaces/{id} {
      function readable(d) {
        return (isUser() && (d.owner == request.auth.uid || request.auth.uid in d.sharedWith))
          || (isMachineToken() && (d.owner == request.auth.token.owner || request.auth.token.owner in d.sharedWith));
      }
      allow read: if readable(resource.data);
      allow create: if isUser()
        && id.matches('^[a-z0-9][a-z0-9-]{0,62}$')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.sharedWith is list;
      allow update: if isUser() && resource.data.owner == request.auth.uid
        && keeps(["owner", "createdAt"])
        && request.resource.data.sharedWith is list;
      allow delete: if isUser() && resource.data.owner == request.auth.uid;
    }

    // ------------------------------------------------------- per-user data
    match /users/{uid} {
      // The Builder's layers (src/core/layers.ts) and saved WadBrowser setups:
      // the owner's alone (public templates come later). The owner's machines
      // read them, to build a layer's image or launch a setup. A template may
      // build on another (`parent`); Extensions layers were "customizations"
      // before they had that name: those are read, moved and deleted.
      function layerId(id) { return id.matches('^[a-z0-9][a-z0-9-]{0,62}$'); }
      function shortList(l) { return l is list && l.size() <= 200; }
      function common(d) {
        return d.get("owner", null) == uid
          && d.get("name", null) is string && d.name.size() >= 1 && d.name.size() <= 80
          && (!("description" in d) || (d.description is string && d.description.size() <= 2000))
          && d.get("createdAt", null) is string && d.get("updatedAt", null) is string
          && (!("deletedAt" in d) || d.deletedAt == null || d.deletedAt is string);
      }
      function validTemplate(d) {
        return d.keys().hasOnly(["owner", "name", "description", "apps", "parent", "starter", "createdAt", "updatedAt", "deletedAt"])
          && common(d)
          && d.get("apps", null) is list && d.apps.size() >= 1 && d.apps.size() <= 40
          && (!("parent" in d) || (d.parent is string && layerId(d.parent)))
          && (!("starter" in d) || d.starter == true);
      }
      function validSetup(d) {
        return d.get("browserMode", null) in ["browser", "focus"]
          && shortList(d.get("webapps", null)) && shortList(d.get("extensions", null))
          && shortList(d.get("tools", null)) && shortList(d.get("autostart", null));
      }
      function validExtensions(d) {
        return d.keys().hasOnly(["owner", "name", "description", "templateId", "browserMode", "webapps", "extensions", "tools", "autostart", "createdAt", "updatedAt", "deletedAt"])
          && common(d) && d.get("templateId", null) is string && layerId(d.templateId) && validSetup(d);
      }
      function validBrowser(d) {
        return d.keys().hasOnly(["owner", "name", "mode", "webapps", "secrets", "createdAt", "updatedAt", "deletedAt"])
          && common(d) && d.get("mode", null) in ["browser", "focus"]
          && shortList(d.get("webapps", null)) && d.get("secrets", null) is map;
      }
      match /templates/{tid} {
        allow read: if isOwner(uid) || isOwnersMachine(uid);
        allow create: if isOwner(uid) && layerId(tid) && validTemplate(request.resource.data);
        allow update: if isOwner(uid) && validTemplate(request.resource.data) && keeps(["owner", "createdAt"]);
        allow delete: if isOwner(uid);
      }
      match /extensions/{eid} {
        allow read: if isOwner(uid) || isOwnersMachine(uid);
        allow create: if isOwner(uid) && layerId(eid) && validExtensions(request.resource.data);
        allow update: if isOwner(uid) && validExtensions(request.resource.data) && keeps(["owner", "createdAt"]);
        allow delete: if isOwner(uid);
      }
      // From before Extensions had that name: read and deleted once moved.
      match /customizations/{cid} {
        allow read: if isOwner(uid) || isOwnersMachine(uid);
        allow delete: if isOwner(uid);
      }
      match /browsers/{bid} {
        allow read: if isOwner(uid) || isOwnersMachine(uid);
        allow create: if isOwner(uid) && layerId(bid) && validBrowser(request.resource.data);
        allow update: if isOwner(uid) && validBrowser(request.resource.data) && keeps(["owner", "createdAt"]);
        allow delete: if isOwner(uid);
      }

      match /drafts/{draftId} {
        allow read, write: if isOwner(uid);
      }

      // Podman secrets for the user's machines (e.g. github_token).
      match /secrets/{name} {
        allow read: if isOwnersMachine(uid);
        allow create, update, delete: if isOwner(uid) && name.matches('^[a-z0-9_-]{1,64}$');
        allow list: if isOwner(uid);
      }

      // Projects: folders of work that wadspaces mount at launch
      // (src/core/projects.ts): a GitHub repository (cloned on each machine),
      // a folder on one machine, or a drive (a filesystem by UUID). The files
      // live on the machines; this is what each project is. wadd's relay syncs
      // it both ways, pushing projects made offline, so the owner's machines
      // create and update too, but never delete: a deletion is a
      // `deleted: true` tombstone, so machines that were away learn of it.
      match /projects/{pid} {
        function validGit(s) {
          return s.keys().hasOnly(["kind", "url", "ref"])
            && s.get("url", null) is string
            && s.url.matches('^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?([.]git)?$')
            && (!("ref" in s) || s.ref is string);
        }
        function validFolder(s) {
          return s.keys().hasOnly(["kind", "machineId", "machineName", "path"])
            && s.get("machineId", null) is string
            && s.get("machineName", null) is string
            && s.get("path", null) is string && s.path.matches('(?s)/.*');
        }
        function validDrive(s) {
          return s.keys().hasOnly(["kind", "uuid", "label", "fstype", "subpath"])
            && s.get("uuid", null) is string && s.uuid.matches('^[A-Za-z0-9-]{4,64}$')
            && s.get("label", null) is string
            && s.get("fstype", null) is string
            && s.get("subpath", null) is string && !s.subpath.matches('(?s).*[.][.].*');
        }
        function validSource(s) {
          return s is map && s.get("kind", "") in ["git", "folder", "drive"]
            && (s.kind != "git" || validGit(s))
            && (s.kind != "folder" || validFolder(s))
            && (s.kind != "drive" || validDrive(s));
        }
        function validProject(d) {
          return d.name is string && d.name.size() >= 1 && d.name.size() <= 200
            && d.mountName is string && d.mountName.matches('^[A-Za-z0-9._-]{1,64}$') && !(d.mountName in [".", ".."])
            && validSource(d.get("source", null))
            && (!("setup" in d) || d.setup is string)
            && (!("deleted" in d) || d.deleted is bool)
            && (!("createdAt" in d) || d.createdAt is timestamp)
            && (!("updatedAt" in d) || d.updatedAt is timestamp)
            // Local to wadd (synced, legacy), the document's own name (id), and
            // what Syncthing needed before projects were GitHub repos.
            && !d.keys().hasAny(["id", "synced", "legacy", "holders", "ignore", "folderId"]);
        }
        allow read: if isOwner(uid) || isOwnersMachine(uid);
        allow create: if (isOwner(uid) || isOwnersMachine(uid))
          && pid.matches('^[A-Za-z0-9_-]{1,64}$') && validProject(request.resource.data);
        allow update: if (isOwner(uid) || isOwnersMachine(uid)) && validProject(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // The user's GitHub repositories, for the online app's "Add from GitHub"
      // (it can't ask GitHub itself: the token stays on the machines). Any of
      // the owner's machines writes the list (wadd/github.py); the owner reads.
      match /github/{name} {
        allow read: if isOwner(uid);
        allow create, update: if isOwnersMachine(uid) && name == "repos"
          && request.resource.data.keys().hasOnly(["login", "repos", "updatedAt"])
          && request.resource.data.login is string
          && request.resource.data.repos is list
          && request.resource.data.updatedAt is timestamp;
      }

      // The cloud relay (wadd/cloud.py): heartbeat + commands.
      match /machines/{mid} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanges(["name"]);
        // Every machine of the owner's reads its siblings (tailnet addresses,
        // the projects mounted there); each writes only its own,
        // with the types the apps read.
        // images: its layer images (GET /v1/images); signins: its saved
        // sign-ins' ids, names and kinds, never what they hold; screen: its
        // logical size, for the Builder's preview.
        function heartbeatTypes(d) {
          return (!("lastSeen" in changed()) || d.lastSeen is timestamp)
            && (!("workspaces" in d) || d.workspaces is list)
            && (!("mountedProjects" in d) || d.mountedProjects is list)
            && (!("view" in d) || d.view == null || d.view is string)
            && (!("images" in d) || d.images is list)
            && (!("signins" in d) || d.signins is list)
            && (!("screen" in d) || d.screen == null || d.screen is map);
        }
        allow read: if isOwnersMachine(uid);
        allow update: if isMachine(uid, mid)
          && onlyChanges(["lastSeen", "hostname", "daemonVersion", "view", "workspaces", "metrics", "installed", "tailnet", "mountedProjects", "images", "signins", "screen"])
          && heartbeatTypes(request.resource.data);

        match /commands/{cmdId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.status == "pending"
            // build: a layer's image; install: a wadspace on its layer, with the
            // wallpaper the app drew; launch-run: anything the launcher starts
            // (wadspaces, throwaway runs, WadBrowser setups, the terminal),
            // optionally as a focus session.
            && request.resource.data.type in ["start", "stop", "restart", "sync-secrets", "projects-sync", "build", "install", "launch-run"];
          allow read: if isMachine(uid, mid);
          allow update: if isMachine(uid, mid) && onlyChanges(["status", "result", "startedAt", "finishedAt", "progress"]);
        }

        match /runs/{runId} {
          allow read: if isOwner(uid);
          allow create, update: if isMachine(uid, mid);
        }
      }
    }

    // One-time codes for linking a machine; redeemed by enrollMachine.
    match /enrollCodes/{code} {
      allow create: if isUser()
        && code.matches('^[A-Z0-9]{6,12}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.used == false;
    }
  }
}
