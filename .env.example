# Copy to .env.local. Firebase is optional: without it Wad Creator runs in
# local-only mode (library kept in this browser, no sign-in).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# wadd on this machine (default http://127.0.0.1:8080)
VITE_WADD_URL=
# Registry the "Install on this machine" image defaults to
VITE_IMAGE_PREFIX=localhost/wadspaces-
