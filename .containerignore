# Build context for host/Containerfile (`podman build -f host/Containerfile .`).
# Only what the Containerfile copies goes in: the repo also holds Rust target
# dirs and the host's secrets, none of which belong in the context. Secrets
# reach the image only through .build/secrets/ (staged by host/build.sh),
# never straight from host/secrets/.
*
!host/etc
!host/usr
!.build/wadd
!.build/client
!.build/hud
!.build/wadbrowser
!.build/assets
!.build/ours.list
!.build/secrets
!.build/ssh
**/__pycache__
