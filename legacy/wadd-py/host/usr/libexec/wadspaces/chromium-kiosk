#!/bin/bash
# The kiosk browser. --remote-debugging-port lets wadd move it between
# workspaces over CDP; it binds 127.0.0.1 only. Never add
# --remote-allow-origins: the Origin check keeps pages away from that socket.
PROFILE="${HOME}/.config/wadspaces-kiosk"
# kiosk-session runs exactly one of these at a time, so any profile lock left
# behind is stale (a forced power-off). Chromium's lock records the hostname,
# and a lock from another hostname makes it refuse to start at all ("profile
# in use on another computer"): a black screen. Clear it every time.
rm -f "${PROFILE}"/Singleton{Lock,Socket,Cookie}

exec /usr/bin/chromium-browser \
    --kiosk \
    --ozone-platform=wayland \
    --remote-debugging-port=9222 \
    --user-data-dir="${PROFILE}" \
    --no-first-run \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=TranslateUI \
    --enable-features=AcceleratedVideoDecodeLinuxGL,VaapiVideoDecoder \
    --password-store=basic \
    --autoplay-policy=no-user-gesture-required \
    --check-for-update-interval=31536000 \
    http://127.0.0.1:8080/
