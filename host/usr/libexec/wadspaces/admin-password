#!/bin/bash
# Give `admin` the baked-in password while it has none, and again whenever the
# baked-in hash changes (a new host/secrets/admin_password_hash on the next
# drive update). A password changed on the machine with `passwd` is left alone
# until then.
set -euo pipefail
HASH_FILE=/usr/lib/wadspaces/secrets/admin_password_hash
APPLIED=/var/lib/wadspaces/admin-password.applied
sum() { sha256sum | cut -d' ' -f1; }
baked="$(sum < "${HASH_FILE}")"
current="$(getent shadow admin | cut -d: -f2)"
case "${current}" in
    ""|"!"|"!!"|"!*"|"*") reason="it had none" ;;
    *) # What was baked in last time; on a machine from before this file was
       # kept, whatever admin has now (usermod -p stores the hash as given).
       last="$(cat "${APPLIED}" 2>/dev/null || printf '%s' "${current}" | sum)"
       if [[ "${last}" == "${baked}" ]]; then
           echo "${baked}" > "${APPLIED}"
           exit 0
       fi
       reason="the baked-in password changed" ;;
esac
usermod -p "$(< "${HASH_FILE}")" admin
echo "${baked}" > "${APPLIED}"
echo "admin password set (${reason})"
