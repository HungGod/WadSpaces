#!/bin/bash
# Give `admin` the baked-in password, but only while it has none: a password
# changed on the machine with `passwd` is left alone.
set -euo pipefail
current="$(getent shadow admin | cut -d: -f2)"
case "${current}" in
    ""|"!"|"!!"|"!*"|"*") usermod -p "$(< /usr/lib/wadspaces/secrets/admin_password_hash)" admin
                  echo "admin password set" ;;
esac
