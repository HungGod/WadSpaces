#!/bin/bash
# The WadSpaces Client, the kiosk's shell (etc/sway/wadspaces.conf). Restarted if it
# ever exits, after a pause so a crash can't spin. Its output goes to the
# journal: journalctl -b -t client.
#
# It runs with two malloc arenas: its few threads (decoding pictures)
# otherwise keep memory they've freed.

# What the Tauri client left: WebKit's storage and caches, and the switch
# that picked between it and the native one. The native client's own
# account/ folder stays. Nothing's there after the first start.
data="${XDG_DATA_HOME:-${HOME}/.local/share}/io.wadspaces.client"
rm -rf "${data}"/{CacheStorage,databases,hsts-storage.sqlite,localstorage,mediakeys,storage,WebKitCache}
rm -f "${XDG_CONFIG_HOME:-${HOME}/.config}/wadspaces/client"

while true; do
    MALLOC_ARENA_MAX=2 systemd-cat -t client /usr/bin/client --kiosk
    sleep 2
done
