#!/usr/bin/python3
"""What floats above every window on a WadSpaces machine: the Home / Wi-Fi /
power buttons, the focus timer, the power menu and the Super+Tab switcher.

They are wlr-layer-shell "overlay" surfaces, which sway stacks above normal
and fullscreen windows, so they show over whatever wadspace is on screen
without switching away from it. None of them takes the keyboard.

- Buttons, anchored bottom-right: Home brings back Wad Creator (what Super+0
  does), Wi-Fi opens Wad Creator's Wi-Fi menu (POST /api/hud), power opens
  the power menu here. During a focus session they give way to a timer icon
  (hover or click it for the time left).
- Power menu: a dimmed screen with Restart / Shut down / Cancel.
- Switcher: wadd's `carousel` events (Super+Tab, wadd/manager.py).

It follows wadd's event stream (/api/events), reconnecting if wadd restarts.

gtk4-layer-shell has to be loaded before libwayland, so this re-executes itself
with it in LD_PRELOAD (the documented way for Python). Without the library
(developing on a desktop) the surfaces are ordinary windows.

WADSPACES_HUD_SNAPSHOT=<dir> renders each surface to a PNG there and exits
(for checking the look without a machine).
"""
import json
import os
import sys
import threading
import time
import urllib.request

LIB = "/usr/lib64/libgtk4-layer-shell.so.0"
if os.path.exists(LIB) and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402
except (ValueError, ImportError):
    LayerShell = None

WADD = os.environ.get("WADD_URL", "http://127.0.0.1:8080")
SNAPSHOT = os.environ.get("WADSPACES_HUD_SNAPSHOT")

CSS = b"""
