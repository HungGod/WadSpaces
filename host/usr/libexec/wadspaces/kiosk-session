#!/bin/bash
# greetd session for the kiosk user: wait for wadd, then run sway, which starts
# WadSpaces Client on the shell (etc/sway/wadspaces.conf).
export XDG_SESSION_TYPE=wayland
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

for _ in $(seq 1 60); do
    curl -fs -o /dev/null --unix-socket /run/wadd/wadd.sock http://wadd/v1/health && break
    sleep 1
done

# Ctrl+Alt+F2 reaches a text console when debugging (wlroots handles VT
# switching). Output goes to the journal (journalctl -b -t kiosk) instead of
# tty1. Loop rather than exec: this is greetd's initial_session, which runs
# once, so restarting sway here is what keeps the kiosk healing itself. The
# pause stops a crash loop from spinning.
while true; do
    systemd-cat -t kiosk dbus-run-session -- sway -c /etc/sway/wadspaces.conf
    sleep 5
done
