# WadSpaces host OS: Fedora bootc -> greetd -> sway -> WadSpaces Client (Tauri),
# plus wadd (the machine daemon: workspaces, projects, the account link;
# apps/wadd, Rust). No browser: what the machine shows of
# the web (GitHub's sign-in) opens in WadSpaces Client's own webview windows. Build from the repo root:
#   host/build.sh image        (or: podman build -f host/Containerfile -t localhost/wadspaces-host .)
FROM quay.io/fedora/fedora-bootc:43

RUN dnf -y install \
      sway greetd podman \
      webkit2gtk4.1 librsvg2 shared-mime-info \
      python3 \
      mesa-dri-drivers libva-utils \
      adwaita-cursor-theme google-noto-sans-fonts google-noto-emoji-fonts liberation-fonts rsms-inter-vf-fonts \
      dbus-daemon dbus-tools wlr-randr NetworkManager-wifi NetworkManager-tui curl \
      gtk4 gtk4-layer-shell \
      git-core \
    && dnf clean all

# Sound: PipeWire in the kiosk session (socket-activated user units). Native
# wadspaces play through its PulseAudio socket (wad-core's quadlet sets
# PULSE_SERVER), and the HUD's volume slider is wpctl (wireplumber).
RUN dnf -y install \
      pipewire pipewire-pulseaudio pipewire-alsa wireplumber alsa-ucm alsa-sof-firmware \
    && dnf clean all \
    && systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service

# The initramfs again, with the Surface's drivers in it, loaded in order in the
# first seconds of boot: without them the stock kernel's controller hub fails
# and graphics (so the backlight) and sound stall for minutes or never come
# (usr/lib/modprobe.d/wadspaces-surface.conf says why). Its own layer, so it
# only reruns when those two files change.
COPY host/usr/lib/modprobe.d/wadspaces-surface.conf /usr/lib/modprobe.d/
COPY host/usr/lib/dracut/dracut.conf.d/60-wadspaces-surface.conf /usr/lib/dracut/dracut.conf.d/
RUN kver="$(ls /usr/lib/modules)" \
    && dracut --force --no-hostonly --kver "${kver}" "/usr/lib/modules/${kver}/initramfs.img" \
    && chmod 644 "/usr/lib/modules/${kver}/initramfs.img" \
    && lsinitrd "/usr/lib/modules/${kver}/initramfs.img" > /tmp/initrd.txt \
    && for m in pinctrl-sunrisepoint surface_aggregator.ko i915.ko snd-hda-intel snd-hda-codec-alc269 kbl_dmc; do \
         grep -q "${m}" /tmp/initrd.txt || { echo "initramfs lacks ${m}" >&2; exit 1; }; \
       done \
    && rm /tmp/initrd.txt

# Tailscale, the trusted network between the owner's machines, from
# Tailscale's own repo. Its own layer, so the ones
# above stay cached. tailscaled keeps its state in /var/lib/tailscale, which
# bootc keeps across updates. Parked for now: installed, but masked below
# (masked rather than just not enabled, because a machine that had it
# enabled keeps that in its /etc across updates).
RUN curl -fsSLo /etc/yum.repos.d/tailscale.repo https://pkgs.tailscale.com/stable/fedora/tailscale.repo \
    && dnf -y install tailscale \
    && dnf clean all

COPY host/etc/ /etc/
COPY host/usr/ /usr/
# The WadSpaces Client, the Tauri app (built by host/build.sh from apps/client).
# It's the shell: wadd keeps its window (app_id "client") on screen.
COPY .build/client-app/client /usr/bin/client
# wadd (apps/wadd), built by host/build.sh. It replaced the Python wadd: on
# the first boot after that one, `wadd migrate` (wadd.service) moves its
# state over; `bootc rollback` goes back to it (host/CUTOVER.md).
COPY .build/wadd/wadd /usr/bin/wadd
# The HUD (apps/hud, Rust + GTK4 layer-shell), built by host/build.sh.
COPY .build/hud/hud /usr/libexec/wadspaces/hud
# Staged by host/build.sh from host/secrets/: the admin password hash, which
# wadspaces-admin-password.service applies. (No podman secrets are baked in:
# a machine gets its GitHub token by signing in, or from the account.)
COPY .build/secrets/ /usr/lib/wadspaces/secrets/
COPY .build/ssh/ /usr/share/wadspaces/ssh/

RUN chmod 755 /usr/libexec/wadspaces/* /usr/bin/wadd /usr/bin/client && \
    /usr/bin/client --version && \
    find /usr/lib/wadspaces/secrets -type d -exec chmod 700 {} + && \
    find /usr/lib/wadspaces/secrets -type f -exec chmod 600 {} + && \
    chmod 644 /usr/share/wadspaces/ssh/* && \
    for b in dbus-run-session sway curl nmcli skopeo bootc tailscale wpctl; do \
      command -v "$b" > /dev/null || { echo "missing $b" >&2; exit 1; }; \
    done && \
    ls /usr/lib/firmware/mrvl/pcie8897_uapsta.bin* /usr/lib64/libgtk4-layer-shell.so.0 > /dev/null && \
    /usr/bin/wadd version && \
    systemctl enable greetd.service podman.socket wadd.socket wadd.service \
      wadspaces-admin-password.service wadspaces-import.service && \
    systemctl mask tailscaled.service && \
    systemctl set-default graphical.target && \
    systemctl mask getty@tty1.service && \
    rm -rf /var/log/dnf5.log* /var/lib/dnf /var/cache/libdnf5 /run/dnf && \
    bootc container lint
