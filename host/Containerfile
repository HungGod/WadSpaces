# WadSpaces host OS: Fedora bootc -> greetd -> sway -> Wad Creator (Tauri),
# plus wadd (the workspace switcher). Chromium stays for viewing other
# machines' streams. Build from the repo root:
#   host/build.sh image        (or: podman build -f host/Containerfile -t localhost/wadspaces-host .)
FROM quay.io/fedora/fedora-bootc:43

RUN dnf -y install \
      sway greetd chromium podman \
      webkit2gtk4.1 librsvg2 shared-mime-info \
      python3 python3-fastapi python3-uvicorn python3-websockets python3-pyyaml \
      python3-evdev python3-httpx \
      mesa-dri-drivers libva-utils \
      adwaita-cursor-theme google-noto-sans-fonts google-noto-emoji-fonts liberation-fonts \
      dbus-daemon dbus-tools wlr-randr NetworkManager-wifi NetworkManager-tui curl \
      gtk4 gtk4-layer-shell python3-gobject \
      git-core \
    && dnf clean all

# Hardware video decode for the WebRTC streams. The Intel VA-API drivers
# (and the full-codec Mesa VA driver for AMD) are only in RPM Fusion.
RUN dnf -y install \
      "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
      "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm" \
    && dnf -y install intel-media-driver libva-intel-driver \
    && if rpm -q mesa-va-drivers > /dev/null; then \
         dnf -y swap mesa-va-drivers mesa-va-drivers-freeworld --allowerasing; \
       else dnf -y install mesa-va-drivers-freeworld; fi \
    && dnf clean all

# Tailscale, the trusted network between the owner's machines
# (wadd/tailnet.py), from Tailscale's own repo. Its own layer, so the ones
# above stay cached. tailscaled keeps its state in /var/lib/tailscale, which
# bootc keeps across updates. Parked for now: installed, but masked below
# (masked rather than just not enabled, because a machine that had it
# enabled keeps that in its /etc across updates).
RUN curl -fsSLo /etc/yum.repos.d/tailscale.repo https://pkgs.tailscale.com/stable/fedora/tailscale.repo \
    && dnf -y install tailscale \
    && dnf clean all

COPY legacy/wadd-py/wadd/ /usr/lib/wadspaces/wadd/
COPY host/etc/ /etc/
COPY host/usr/ /usr/
# Wad Creator, the Tauri app (built by host/build.sh from apps/wadcreator). Not
# under /usr/lib/wadcreator: wadd adopts windows from that old Electron path
# as a workspace, and this one is the shell.
COPY .build/wadcreator-app/wadcreator /usr/bin/wadcreator
# The HUD (apps/hud, Rust + GTK4 layer-shell), built by host/build.sh.
COPY .build/hud/hud /usr/libexec/wadspaces/hud
# Staged by host/build.sh from host/secrets/. wadd seeds podman secrets from
# here; the admin hash is applied by wadspaces-admin-password.service.
COPY .build/secrets/ /usr/lib/wadspaces/secrets/
COPY .build/ssh/ /usr/share/wadspaces/ssh/

RUN chmod 755 /usr/libexec/wadspaces/* /usr/bin/wadd /usr/bin/wadcreator && \
    /usr/bin/wadcreator --version && \
    find /usr/lib/wadspaces/secrets -type d -exec chmod 700 {} + && \
    find /usr/lib/wadspaces/secrets -type f -exec chmod 600 {} + && \
    chmod 644 /usr/share/wadspaces/ssh/* && \
    for b in dbus-run-session sway chromium-browser curl nmcli skopeo bootc tailscale; do \
      command -v "$b" > /dev/null || { echo "missing $b" >&2; exit 1; }; \
    done && \
    ls /usr/lib/firmware/mrvl/pcie8897_uapsta.bin* /usr/lib64/libgtk4-layer-shell.so.0 > /dev/null && \
    PYTHONPATH=/usr/lib/wadspaces python3 -m wadd --config /etc/wadspaces/workspaces.yaml \
      gen-quadlets --out /etc/containers/systemd && \
    systemctl enable greetd.service podman.socket wadd.service wadspaces-admin-password.service wadspaces-import.service && \
    systemctl mask tailscaled.service && \
    systemctl set-default graphical.target && \
    systemctl mask getty@tty1.service && \
    rm -rf /var/log/dnf5.log* /var/lib/dnf /var/cache/libdnf5 /run/dnf && \
    bootc container lint
