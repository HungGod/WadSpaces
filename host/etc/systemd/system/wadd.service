[Unit]
Description=WadSpaces workspace switcher (wadd)
Wants=network-online.target podman.socket
After=network-online.target podman.socket

[Service]
Type=exec
# --no-cdp: the shell is Wad Creator (a Tauri app), not a browser to steer.
ExecStart=/usr/bin/wadd --config /etc/wadspaces/workspaces.yaml serve --no-cdp
Restart=always
RestartSec=2
TimeoutStopSec=10
StateDirectory=wadspaces
# Root: it needs the rootful podman socket, systemctl for the quadlet units,
# and /dev/input for hotkeys. Everything else is locked down.
ProtectSystem=strict
# read-only, not "yes": wadd connects to sway's IPC socket in the kiosk
# session's /run/user/1000 (to put native workspaces on screen). That dir only
# appears once greetd logs the kiosk in, after wadd has started; "yes" would
# hide it for good. Connecting to a socket works on a read-only mount.
ProtectHome=read-only
# wadspaces-projects: project folders (git imports, as uid 1000). Podman's
# volumes: a launch moves a project an older image cloned into a workspace's
# /config volume over to its folder (launches.py). "-": the volumes dir only
# exists once podman has made a volume.
ReadWritePaths=/var/lib/wadspaces /etc/wadspaces /etc/containers/systemd /run/podman
ReadWritePaths=-/var/lib/wadspaces-projects -/var/lib/containers/storage/volumes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
