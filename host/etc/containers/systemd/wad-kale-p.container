# Generated by `wadd gen-quadlets` from workspaces.yaml. Do not edit.
[Unit]
Description=WadSpaces workspace: Kale Phone
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/hunggod/wadspaces-kale-p:latest
ContainerName=wad-kale-p
Label=wadspaces.id=kale-p
PublishPort=127.0.0.1:3150:3000
Environment=GIT_USER_EMAIL=throwupcow@gmail.com
Environment=GIT_USER_NAME=HungGod
Environment=PGID=1000
Environment=PUID=1000
Environment=TZ=Pacific/Fiji
Secret=github_token
Volume=wad-kale-p-config:/config:z
AddDevice=/dev/dri
AddDevice=/dev/kvm
ShmSize=1g
Pull=missing

[Service]
Restart=no
TimeoutStartSec=900

# No [Install] section: wadd starts this unit on the first switch.
