# Generated by `wadd gen-quadlets` from workspaces.yaml. Do not edit.
[Unit]
Description=WadSpaces workspace: Wad Creator Dev
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/hunggod/wadspaces-wad-c:latest
ContainerName=wad-wad-c
Label=wadspaces.id=wad-c
PublishPort=127.0.0.1:3120:3000
Environment=GIT_USER_EMAIL=throwupcow@gmail.com
Environment=GIT_USER_NAME=HungGod
Environment=PGID=1000
Environment=PUID=1000
Environment=TZ=Pacific/Fiji
Secret=github_token
Volume=wad-wad-c-config:/config:z
AddDevice=/dev/dri
ShmSize=1g
Pull=missing

[Service]
Restart=no
TimeoutStartSec=900

# No [Install] section: wadd starts this unit on the first switch.
