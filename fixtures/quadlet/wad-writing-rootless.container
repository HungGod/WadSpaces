# Generated by `wadd gen-quadlets` from workspaces.yaml. Do not edit.
[Unit]
Description=WadSpaces workspace: Writing
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/wadspaces-writing:latest
ContainerName=wad-writing
Label=wadspaces.id=writing
UIDMap=0:1:1000
UIDMap=1000:0:1
UIDMap=1001:1001:64535
GIDMap=0:1:1000
GIDMap=1000:0:1
GIDMap=1001:1001:64535
Environment=PUID=1000
Environment=TZ=Pacific/Fiji
Secret=github_token
Volume=/home/u/.local/share/wadspaces-projects/p1:/config/Desktop/Notes:rw,z
Volume=/home/u/.local/state/wadspaces/extra/writing:/run/wadspaces-extra:ro,z
Volume=/run/user/1000:/run/wadspaces-display
Environment=PULSE_SERVER=unix:/run/wadspaces-display/pulse/native
SecurityLabelDisable=true
AddDevice=/dev/dri
ShmSize=1g
Pull=missing

[Service]
Restart=no
TimeoutStartSec=900

# No [Install] section: wadd starts this unit on the first switch.
