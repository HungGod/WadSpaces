# Generated by `wadd gen-quadlets` from workspaces.yaml. Do not edit.
[Unit]
Description=WadSpaces workspace: Writing
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/hunggod/wadspaces-cosmic-bodybuilding:latest
ContainerName=wad-writing
Label=wadspaces.id=writing
Environment=PGID=1000
Environment=PUID=1000
Environment=TZ=Pacific/Fiji
Secret=github_token
Volume=wad-writing-obsidian:/config/.config/obsidian:z
Volume=/var/lib/wadspaces-projects/wrtvault0000000000ab:/config/Desktop/Writing:rw,z
Volume=/var/lib/wadspaces-projects/notes000000000000000:/config/Desktop/Notes:rw,z
Volume=/var/lib/wadspaces/extra/writing:/run/wadspaces-extra:ro,z
Volume=/run/user/1000:/run/wadspaces-display
Environment=PULSE_SERVER=unix:/run/wadspaces-display/pulse/native
SecurityLabelDisable=true
AddDevice=/dev/dri
ShmSize=1g
Pull=missing

[Service]
Restart=no
TimeoutStartSec=900

# No [Install] section: wadd starts this unit on the first switch.
